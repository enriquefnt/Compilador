; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

[Setup]
[Languages]
Name: "spanish"; MessagesFile: "compiler:Languages\Spanish.isl"

[Setup]
AppName=Compilador de PDFs
AppVersion=1.0.1
AppPublisher=Enrique Finetti
; AppPublisherURL=https://tu-sitio.com
DefaultDirName={pf}\CompiladorPDFs
DefaultGroupName=CompiladorPDFs
OutputBaseFilename=CompiladorPDFs_Instalador
Compression=lzma
SolidCompression=yes
SetupIconFile=C:\local_web\Compilador\DistribucionApp\compilador.ico
; LicenseFile=C:\local_web\Compilador\license.txt  ; Opcional

[Tasks]
Name: "desktopicon"; Description: "Crear un icono en el escritorio"; GroupDescription: "Opciones adicionales"

[Files]
Source: "C:\local_web\Compilador\DistribucionApp\CompiladorPDFs.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\local_web\Compilador\DistribucionApp\gs\*"; DestDir: "{app}\gs"; Flags: recursesubdirs createallsubdirs ignoreversion
Source: "C:\local_web\Compilador\DistribucionApp\compilador.ico"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{group}\Compilador de PDFs"; Filename: "{app}\CompiladorPDFs.exe"; IconFilename: "{app}\compilador.ico"
Name: "{userdesktop}\Compilador de PDFs"; Filename: "{app}\CompiladorPDFs.exe"; IconFilename: "{app}\compilador.ico"; Tasks: desktopicon
Name: "{group}\Desinstalar Compilador de PDFs"; Filename: "{app}\Unistall000.exe"

[Run]
Filename: "{app}\CompiladorPDFs.exe"; Description: "Ejecutar Compilador de PDFs"; Flags: nowait postinstall skipifsilent
